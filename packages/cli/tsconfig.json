{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "paths": {
      "@workflow-archaeologist/core": ["../core/src"],
      "@workflow-archaeologist/core/*": ["../core/src/*"]
    },
    "declaration": true,
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "types": ["node"],
    "composite": true,
    "moduleResolution": "node16"
  },
  "include": ["src"],
  "references": [
    { "path": "../core" }
  ]
}
